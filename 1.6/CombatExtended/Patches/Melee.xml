<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Make Apex melee deterministic even when CE's weapon autopatcher is disabled.
	     These values mirror CombatExtended.Compatibility.RaceUtil.ConvertTool exactly:
	     preserve explicit vanilla AP on both CE channels, otherwise use 0.5 sharp / 2 blunt. -->
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[starts-with(defName, "APM_") or starts-with(@Name, "APM_")]/tools/li[not(@Class)]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.ToolCE</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[starts-with(defName, "APM_") or starts-with(@Name, "APM_")]/tools/li[not(armorPenetration)]</xpath>
		<value>
			<armorPenetrationSharp>0.5</armorPenetrationSharp>
			<armorPenetrationBlunt>2</armorPenetrationBlunt>
		</value>
	</Operation>

	<!-- Whips use a custom area verb rather than Verb_MeleeAttackCE. Route their primary hit
	     through the CE adapter and give CE's sharp-to-blunt deflection path the matching blunt AP. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="APM_Weapon_MechWhip" or defName="APM_Weapon_PlasmaWhip"]/verbs/li/verbClass</xpath>
		<value><verbClass>ApexMechanoids.CombatExtended.Verb_WhipCE</verbClass></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/DamageDef[defName="APM_Whip"][not(defaultArmorPenetration)]</xpath>
		<value><defaultArmorPenetration>2</defaultArmorPenetration></value>
	</Operation>

	<!-- Dominion psy-spear. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_DuelistsPsySpear"]/tools/li[label="handle"]</xpath>
		<value><armorPenetrationSharp>0.40</armorPenetrationSharp><armorPenetrationBlunt>0.40</armorPenetrationBlunt></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_DuelistsPsySpear"]/tools/li[label="point"]</xpath>
		<value><armorPenetrationSharp>0.95</armorPenetrationSharp><armorPenetrationBlunt>0.95</armorPenetrationBlunt></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_DuelistsPsySpear"]/tools/li[label="edge"]</xpath>
		<value><armorPenetrationSharp>0.70</armorPenetrationSharp><armorPenetrationBlunt>0.70</armorPenetrationBlunt></value>
	</Operation>

	<!-- Severing blade. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_SeveringBlade"]/tools/li[label="handle"]</xpath>
		<value><armorPenetrationSharp>0.45</armorPenetrationSharp><armorPenetrationBlunt>0.45</armorPenetrationBlunt></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_SeveringBlade"]/tools/li[label="point"]</xpath>
		<value><armorPenetrationSharp>0.80</armorPenetrationSharp><armorPenetrationBlunt>0.80</armorPenetrationBlunt></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_SeveringBlade"]/tools/li[label="blade"]</xpath>
		<value><armorPenetrationSharp>0.88</armorPenetrationSharp><armorPenetrationBlunt>0.88</armorPenetrationBlunt></value>
	</Operation>

	<!-- Skipblade. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_Skipblade"]/tools/li[label="handle"]</xpath>
		<value><armorPenetrationSharp>0.30</armorPenetrationSharp><armorPenetrationBlunt>0.30</armorPenetrationBlunt></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_Skipblade"]/tools/li[label="point"]</xpath>
		<value><armorPenetrationSharp>0.85</armorPenetrationSharp><armorPenetrationBlunt>0.85</armorPenetrationBlunt></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="APM_Weapon_Skipblade"]/tools/li[label="blade"]</xpath>
		<value><armorPenetrationSharp>0.85</armorPenetrationSharp><armorPenetrationBlunt>0.85</armorPenetrationBlunt></value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[starts-with(defName, "APM_") or starts-with(@Name, "APM_")]/tools/li/armorPenetration</xpath>
	</Operation>
</Patch>
