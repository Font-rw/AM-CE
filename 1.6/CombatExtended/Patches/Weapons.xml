	<!-- CE mechanoids receive four to six spare primary magazines. -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/PawnKindDef[defName="APM_Mech_Conqueror_AR" or defName="APM_Mech_Conqueror_DMR" or defName="APM_Mech_Conqueror_SMG" or defName="APM_Mech_Dynamo" or defName="APM_Mech_Pulse" or defName="APM_Mech_Satellite" or defName="APM_Mech_Vassal"]</xpath>
		<value>
			<li Class="CombatExtended.LoadoutPropertiesExtension">
				<primaryMagazineCount>
					<min>4</min>
					<max>6</max>
				</primaryMagazineCount>
			</li>
		</value>
	</Operation>
</Patch>
